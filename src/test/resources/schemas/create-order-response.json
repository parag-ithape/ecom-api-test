{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Create order response",
  "type": "object",
  "required": ["orders", "productOrderId", "message"],
  "properties": {
    "orders": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-f]{24}$" }
    },
    "productOrderId": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[0-9a-f]{24}$" }
    },
    "message": { "type": "string" }
  }
}
